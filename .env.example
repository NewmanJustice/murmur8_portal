# =============================================================================
# murmur8 Portal — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.example is safe to commit; .env.local is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/murmur8_portal"

# -----------------------------------------------------------------------------
# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# -----------------------------------------------------------------------------
# NextAuth
# Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Admin Access
# GitHub user ID granted admin status on first sign-in.
# Find your GitHub user ID at https://api.github.com/users/<your-username>
# -----------------------------------------------------------------------------
ADMIN_GITHUB_ID="your-github-user-id"

# -----------------------------------------------------------------------------
# GitHub Org Restriction (optional)
# Set GITHUB_ORG_CHECK=true to restrict sign-in to members of a specific GitHub org.
# GITHUB_ORG must be the org's login name (e.g. "my-company").
# Requires the GitHub OAuth App to be approved for the org if membership is private.
# -----------------------------------------------------------------------------
GITHUB_ORG_CHECK="false"
GITHUB_ORG=""
