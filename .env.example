# =============================================================================
# murmur8 Portal — Environment Variables
# Copy this file to .env.local and fill in real values.
# .env.example is safe to commit; .env.local is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/murmur8_portal"

# -----------------------------------------------------------------------------
# GitHub OAuth (create an OAuth App at https://github.com/settings/developers)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# -----------------------------------------------------------------------------
# NextAuth
# Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Admin Access
# GitHub user ID(s) granted admin status on first sign-in (comma-separated)
# Find your GitHub user ID at https://api.github.com/users/<your-username>
# -----------------------------------------------------------------------------
ADMIN_GITHUB_ID="your-github-user-id"
